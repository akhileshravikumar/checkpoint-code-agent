# ---- Local inference ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:3b
# A full-file rewrite carries the file twice: source in the prompt, new_content
# in the reply. At MAX_FILE_LINES=200 that is ~4.4k tokens each way.
OLLAMA_NUM_CTX=16384
OLLAMA_NUM_PREDICT=1536        
OLLAMA_NUM_PREDICT_REWRITE=6144  
OLLAMA_TEMPERATURE=0.1
OLLAMA_NUM_THREAD=0          # 0 = let Ollama decide

# ---- Target repository the agent modifies ----
GITHUB_TOKEN=github_pat_xxx  # fine-grained, scoped to ONE repo
GITHUB_OWNER=your-username
GITHUB_REPO=checkpoint-sandbox
GITHUB_BASE_BRANCH=main
WORKSPACE_DIR=./.workspace   # local clone the agent patches

# ---- Observability ----
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_pt_xxx
LANGSMITH_PROJECT=checkpoint
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ---- Behaviour ----
CHECKPOINT_DB=./checkpoint.sqlite
MAX_FILE_LINES=200
MAX_RETRIES=2
CI_POLL_INTERVAL=10
CI_POLL_TIMEOUT=600
CHECKPOINT_OFFLINE=0         # 1 = no tracing, stub GitHub (ADR-004)
